<Window x:Class="SfDataGrid_Demo4_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:View="clr-namespace:SfDataGrid_Demo4_8.ViewModel"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SfDataGrid_Demo4_8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <View:ViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:CaptionSummaryCellStyleSelector x:Key="captionSummaryStyleSelector"/>
    </Window.Resources>
    <Grid>
        <syncfusion:SfDataGrid 
            x:Name="dataGrid"
            SelectionMode="Single"
            AutoExpandGroups="True"
            SelectionUnit="Cell"
            ItemsSource="{Binding Orders}"
            ShowGroupDropArea="True"
            CaptionSummaryCellStyleSelector="{StaticResource captionSummaryStyleSelector}"
            >
            <syncfusion:SfDataGrid.CaptionSummaryRow>
                <syncfusion:GridSummaryRow ShowSummaryInRow="False">
                    <syncfusion:GridSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn Name="price"
                                              Format="'Sum: {Sum:c}'"
                                              MappingName="OrderID"
                                              SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="customerID"
                                              Format="Count: '{Count}'"
                                              MappingName="CustomerID"
                                              SummaryType="CountAggregate" />
                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridSummaryRow>
            </syncfusion:SfDataGrid.CaptionSummaryRow>
        </syncfusion:SfDataGrid>
    </Grid>
</Window>
